## How does farms correlate to the dropout rate?

```{r}
ggplot(MCPS_clean, aes(x = FARMS_rate, y = grad_rate, color = total)) +
  geom_point(size = 3, alpha = 0.8) +
  geom_smooth(method = "lm", color = "black", se = FALSE) +
  scale_color_gradient(low = "lightpink", high = "darkred") +
  labs(
    title = "FARMS vs Dropout (Colored by Graduation Rate)",
    x = "FARMS Rate",
    y = "Dropout Rate",
    color = "Graduation Rate"
  ) +
  theme_get()
```



## correlation analysis

```{r}
MD_clean |> 
  select(poverty_rate, median_income, unemployment_rate) |>
  cor(use = "complete.obs")
```


```{r}
ggplot(MD_clean, aes(x = unemployment_rate, y = poverty_rate)) +
  geom_point(color = "darkred", size = 3) +
  geom_smooth(method = "lm") +
  labs(
    title = "Unemployment vs Poverty (Maryland Counties)"
  ) +
  theme_minimal()
```

```{r}
ggplot(MD_clean |> arrange(median_income), 
       aes(x = reorder(county, median_income), y = median_income, group = 1)) +
  geom_line() +
  geom_point() +
  coord_flip() +
  labs(
    title = "Income Trend Across Counties"
  )
```
